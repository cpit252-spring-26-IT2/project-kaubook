<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="sa.edu.kau.fcit.cpit252.project.MainController"
            prefWidth="1100"
            prefHeight="680"
            styleClass="main-root">

    <top>
        <VBox styleClass="top-bar">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="📚 KauBook" styleClass="brand-title"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="userLabel" text="" styleClass="user-label"/>
                <Label fx:id="roleLabel" text="" styleClass="role-label"/>

                <Label text="Sort by:" styleClass="top-label"/>
                <ComboBox fx:id="sortCombo" styleClass="top-combo"/>

                <Button text="+ New Listing"
                        onAction="#openCreateDialog"
                        styleClass="top-primary-btn"/>

                <Button text="Logout"
                        onAction="#logout"
                        styleClass="top-outline-btn"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="search-bar">
                <TextField fx:id="searchField"
                           promptText="Search by course code..."
                           prefWidth="320"
                           styleClass="search-field"/>
                <Button text="Clear"
                        onAction="#clearSearch"
                        styleClass="clear-btn"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="12" prefWidth="190" styleClass="side-panel">
            <Label text="FILTER BY TYPE" styleClass="side-heading"/>

            <Button text="All"
                    userData="ALL"
                    maxWidth="Infinity"
                    onAction="#filterListings"
                    styleClass="filter-btn"/>

            <Button text="💰 Sell"
                    userData="SELL"
                    maxWidth="Infinity"
                    onAction="#filterListings"
                    styleClass="filter-btn"/>

            <Button text="📚 Borrow"
                    userData="BORROW"
                    maxWidth="Infinity"
                    onAction="#filterListings"
                    styleClass="filter-btn"/>

            <Button text="🔄 Exchange"
                    userData="EXCHANGE"
                    maxWidth="Infinity"
                    onAction="#filterListings"
                    styleClass="filter-btn"/>

            <Separator/>

            <Label text="STATS" styleClass="side-heading"/>

            <VBox spacing="10">
                <VBox spacing="4" styleClass="stat-card">
                    <Label text="Total Listings" styleClass="stat-title"/>
                    <Label fx:id="totalLabel" text="0" styleClass="stat-value"/>
                </VBox>

                <VBox spacing="4" styleClass="stat-card">
                    <Label text="Urgent" styleClass="stat-title"/>
                    <Label fx:id="urgentLabel" text="0" styleClass="stat-value"/>
                </VBox>

                <VBox spacing="4" styleClass="stat-card">
                    <Label text="Verified" styleClass="stat-title"/>
                    <Label fx:id="verifiedLabel" text="0" styleClass="stat-value"/>
                </VBox>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" styleClass="content-wrap">
            <VBox spacing="8" styleClass="table-card" VBox.vgrow="ALWAYS">
                <Label text="Available Listings" styleClass="section-main-title"/>
                <Label text="Browse, sort, and manage course book listings in one place."
                       styleClass="section-subtitle"/>

                <TableView fx:id="listingsTable" styleClass="listings-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="courseCol" text="Course" prefWidth="110"/>
                        <TableColumn fx:id="typeCol" text="Type" prefWidth="100"/>
                        <TableColumn fx:id="conditionCol" text="Condition" prefWidth="95"/>
                        <TableColumn fx:id="priceCol" text="Price" prefWidth="100"/>
                        <TableColumn fx:id="tagsCol" text="Tags" prefWidth="130"/>
                        <TableColumn fx:id="ownerCol" text="Listed by" prefWidth="110"/>
                        <TableColumn fx:id="summaryCol" text="Summary" prefWidth="720"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="bottom-bar">
            <Label fx:id="statusLabel" text="Ready" styleClass="status-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="removeBtn"
                    text="Remove Selected"
                    onAction="#removeListing"
                    styleClass="danger-btn"/>
            <Button text="Request Selected"
                    onAction="#requestSelectedListing"
                    styleClass="top-primary-btn"/>

            <Button text="Review Requests"
                    onAction="#reviewMyRequests"
                    styleClass="review-btn"/>

            <Button text="My Requests"
                    onAction="#viewMyRequests"
                    styleClass="my-requests-btn"/>


        </HBox>
    </bottom>

</BorderPane>