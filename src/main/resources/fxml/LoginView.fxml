<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="sa.edu.kau.fcit.cpit252.project.LoginController"
      alignment="CENTER"
      spacing="0"
      prefWidth="420"
      prefHeight="520"
      styleClass="login-root">

    <VBox alignment="CENTER" spacing="8" style="-fx-padding: 0 0 30 0;">
        <Label text="📚" styleClass="login-brand-icon"/>
        <Label text="KauBook" styleClass="login-brand-title"/>
        <Label text="University Books &amp; Notes Exchange" styleClass="login-brand-subtitle"/>
    </VBox>

    <VBox spacing="14"
          alignment="CENTER"
          styleClass="login-card">

        <Label text="Sign in to your account" styleClass="login-title"/>

        <VBox spacing="5" maxWidth="Infinity">
            <Label text="Username" styleClass="field-label"/>
            <TextField fx:id="usernameField"
                       promptText="Enter username"
                       maxWidth="Infinity"
                       styleClass="modern-input"/>
        </VBox>

        <VBox spacing="5" maxWidth="Infinity">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter password"
                           maxWidth="Infinity"
                           styleClass="modern-input"/>
        </VBox>

        <Label fx:id="errorLabel" text="" styleClass="error-label"/>

        <Button text="Sign In"
                onAction="#handleLogin"
                maxWidth="Infinity"
                styleClass="primary-btn"/>

        <Separator/>

        <VBox spacing="4" alignment="CENTER">
            <Label text="Demo accounts:" styleClass="hint-label"/>
            <Label text="admin / admin123  •  Ali / Ali123  •  Mohammed / Mohammed123"
                   wrapText="true"
                   textAlignment="CENTER"
                   styleClass="hint-label-muted"/>
        </VBox>


    </VBox>

</VBox>